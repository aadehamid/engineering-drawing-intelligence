{
  "base": "R0 as generated by scripts/dexpi_generate.py, with DEMO-PID-001.xml removed",
  "cases": [
    {
      "name": "schema-unknown-element",
      "stage": "schema",
      "file": "DEMO-PID-002.xml",
      "find": "<Object id=\"Equipment_102\" type=\"Plant/ProcessEquipment.Tank\">\n",
      "replace": "<Object id=\"Equipment_102\" type=\"Plant/ProcessEquipment.Tank\">\n            <Colour>red</Colour>\n"
    },
    {
      "name": "schema-document-type",
      "stage": "schema",
      "file": "DEMO-PID-002.xml",
      "find": "<?xml version='1.0' encoding='UTF-8'?>\n",
      "replace": "<?xml version='1.0' encoding='UTF-8'?>\n<!DOCTYPE Model [<!ENTITY name \"DEMO-PID-002\">]>\n"
    },
    {
      "name": "references-dangling-id",
      "stage": "references",
      "file": "DEMO-PID-002.xml",
      "find": "objects=\"#Equipment_102_Nozzle_Instrument_105\"",
      "replace": "objects=\"#Equipment_102_Nozzle_Instrument_999\""
    },
    {
      "name": "references-unpinned-import",
      "stage": "references",
      "file": "DEMO-PID-002.xml",
      "find": "source=\"https://data.dexpi.org/models/2.0.1/Plant.xml\"",
      "replace": "source=\"https://data.dexpi.org/models/2.0.1/MetaData.xml\""
    },
    {
      "name": "references-unknown-class",
      "stage": "references",
      "file": "DEMO-PID-002.xml",
      "find": "type=\"Plant/ProcessEquipment.Tank\"",
      "replace": "type=\"Plant/ProcessEquipment.Tankk\""
    },
    {
      "name": "references-unresolved-named-reference",
      "stage": "references",
      "file": "DEMO-PID-002.xml",
      "find": "objects=\"#Equipment_102_Nozzle_Instrument_105\"",
      "replace": "objects=\"Plant/ProcessEquipment.Tankk\""
    },
    {
      "name": "model-abstract-class",
      "stage": "model",
      "file": "DEMO-PID-002.xml",
      "find": "type=\"Plant/ProcessEquipment.Tank\"",
      "replace": "type=\"Plant/ProcessEquipment.ProcessEquipment\""
    },
    {
      "name": "model-missing-required-property",
      "stage": "model",
      "file": "DEMO-PID-002.xml",
      "find": "        <Data property=\"Name\">\n          <String>DEMO-PID-002</String>\n        </Data>\n",
      "replace": ""
    },
    {
      "name": "model-undeclared-property",
      "stage": "model",
      "file": "DEMO-PID-002.xml",
      "find": "<Data property=\"TagNamePrefix\">",
      "replace": "<Data property=\"TagPrefix\">"
    },
    {
      "name": "model-named-reference-wrong-class",
      "stage": "model",
      "file": "DEMO-PID-002.xml",
      "find": "objects=\"#Equipment_102_Nozzle_Instrument_105\"",
      "replace": "objects=\"Plant/ProcessEquipment.Tank\""
    },
    {
      "name": "liong_rules-unsupported-class",
      "stage": "liong_rules",
      "file": "DEMO-PID-002.xml",
      "find": "type=\"Plant/ProcessEquipment.Tank\"",
      "replace": "type=\"Plant/ProcessEquipment.Vessel\""
    },
    {
      "name": "liong_rules-duplicate-tag",
      "stage": "liong_rules",
      "file": "DEMO-PID-002.xml",
      "find": "<String>TK-102</String>",
      "replace": "<String>L-101-5</String>"
    },
    {
      "name": "liong_rules-named-reference",
      "stage": "liong_rules",
      "file": "DEMO-PID-002.xml",
      "find": "objects=\"#Equipment_102_Nozzle_Instrument_105\"",
      "replace": "objects=\"Plant/ProcessEquipment.Nozzle\""
    },
    {
      "name": "liong_rules-missing-sidecar-entry",
      "stage": "liong_rules",
      "file": "sidecar.json",
      "remove_key": [
        "objects",
        "p3d:object:105"
      ]
    }
  ]
}
